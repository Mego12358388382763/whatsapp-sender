# SQLite by default; Postgres: postgresql+psycopg://user:pass@host/db
DATABASE_URL=sqlite:///./data/ghci.db

# LLM: none | anthropic | openai   (none = free heuristic classifier)
LLM_PROVIDER=none
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Cheap first-pass model and stronger synthesis model (override as needed)
LLM_FAST_MODEL=
LLM_STRONG_MODEL=
LLM_BATCH_SIZE=25

# Official platform APIs (optional)
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=gulf-health-intel/0.1 (by u/your_username)
X_BEARER_TOKEN=

# Optional third-party data provider (you are responsible for provider compliance)
APIFY_TOKEN=

# Comments scoring >= this are "relevant"
RELEVANCE_THRESHOLD=40
